PORT=4000
NODE_ENV=development
# El esquema de cada módulo está definido en prisma/schema; la URL no necesita ?schema=
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ecimycampus_db
# Obligatorio. Este valor solo se acepta con NODE_ENV=development o test.
JWT_SECRET=dev_jwt_secret_key_for_eci_mycampus_local_only
# Orígenes separados por coma. Sin definir: con NODE_ENV=development o test refleja el origen; si no, sin CORS.
CORS_ORIGIN=http://localhost:3000
# true solo detrás de un proxy que controle X-Forwarded-For, como el ingress de Azure
TRUST_PROXY=false
# Opcional: sin clave se usa ConsoleEmailAdapter (los correos solo se registran en el log)
RESEND_API_KEY=
EMAIL_FROM=ECI-MyCampus <no-reply@ecimycampus.dev>
# Opcional, solo para `npm run prisma:seed`: crea un ADMIN si no existe (contraseña de 12 caracteres o más)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
