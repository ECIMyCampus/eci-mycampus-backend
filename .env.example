PORT=4000
NODE_ENV=development
# El esquema de cada módulo está definido en prisma/schema; la URL no necesita ?schema=
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ecimycampus_db
JWT_SECRET=dev_jwt_secret_key_for_eci_mycampus_local_only
# Uno o varios orígenes separados por coma
CORS_ORIGIN=http://localhost:3000
# Opcional: sin clave se usa ConsoleEmailAdapter (los correos solo se registran en el log)
RESEND_API_KEY=
EMAIL_FROM=ECI-MyCampus <no-reply@ecimycampus.dev>
